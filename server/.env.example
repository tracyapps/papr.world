# Keep these server-side. Never prefix the secret with PUBLIC_ or VITE_.
CLERK_SECRET_KEY=sk_test_replace_me

# Accept Clerk session tokens minted only by these browser origins.
CLERK_AUTHORIZED_PARTIES=https://papr.world,http://localhost:4321

# Comma-separated Clerk user ids allowed into /admin. Bootstrap your first
# account in Clerk, then copy its user_... id here.
PP_ADMIN_CLERK_USER_IDS=user_replace_me

# Where a player lands after accepting a Clerk invitation.
PP_CLERK_INVITATION_REDIRECT_URL=https://papr.world/

# Pooled Neon connection string. The server creates its idempotent account and
# world tables on boot. Keep this server-side and include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
