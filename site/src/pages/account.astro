---
import Base from '../layouts/Base.astro';
import DeskArt from '../components/DeskArt.astro';

const clerkPublishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
const apiUrl = import.meta.env.PUBLIC_PAPR_API_URL
  ?? 'https://paprworld-production.up.railway.app';
---

<Base
  title="Your desk"
  description="Your papr.world account, worlds, and traveling scrapbook."
  sky={false}
  noindex
>
  <section
    class="desk"
    data-account-shell
    data-clerk-publishable-key={clerkPublishableKey}
    data-api-url={apiUrl}
  >
    <header class="desk__head">
      <div>
        <p class="label">Your place between worlds</p>
        <h1 class="hand desk__title">Your desk</h1>
        <p class="desk__lede">The things that belong to you, even when you leave a neighborhood.</p>
        <p class="desk__alpha">
          <strong>Early alpha.</strong> Expect rough edges — and now and then a
          world or progress reset. Send feedback from the game’s Help menu.
        </p>
      </div>
      <div data-account-user-button></div>
    </header>

    <p class="desk__notice" data-account-message role="status" aria-live="polite">
      Opening your desk…
    </p>

    <div class="desk__signin" data-account-signin hidden>
      <div data-account-signin-target></div>
    </div>

    <section class="paper-card claim" data-account-claim hidden>
      <p class="label">One-time bridge</p>
      <h2>Bring your paper passport home</h2>
      <p data-claim-description>Checking this browser for a paper passport…</p>
      <p class="soft">
        Existing players keep their mail, pouch, and maker credits. New players get
        a fresh passport, a private solo world, and Shared World access automatically.
      </p>
      <button class="btn" type="button" data-claim-button disabled>Claim this passport</button>
      <a class="btn btn--quiet" href="/enter/">Enter a neighborhood</a>
    </section>

    <div data-account-claimed hidden>

      <!-- ── Your doors ────────────────────────────────────────────────
           First, and full width. Going somewhere is the reason somebody
           opens this page; everything else is housekeeping. ──────────── -->
      <section class="paper-card doors">
        <div class="panel-head">
          <div>
            <p class="label">Worlds</p>
            <h2>Your doors</h2>
            <p class="soft">
              These permissions belong to your account rather than an expiring
              neighborhood link.
            </p>
          </div>
        </div>
        <div class="world-list" data-world-list></div>
      </section>

      <!-- ── At a glance ───────────────────────────────────────────────
           Unequal columns on purpose. The card is what other people see,
           so it wants room; the three status lines are one sentence each
           and do not want the same width as it. ────────────────────── -->
      <div class="desk-glance">
        <section class="paper-card card-preview">
          <div class="panel-head">
            <div>
              <p class="label">How you are seen</p>
              <h2>Your card</h2>
            </div>
          </div>
          <div class="card-preview" data-card-preview>
            <p class="soft">Opening your card…</p>
          </div>
          <p class="card-preview__actions">
            <button class="btn btn--quiet" type="button" data-open-profile>Update my profile</button>
          </p>
        </section>

        <section class="paper-card glance">
          <div class="panel-head">
            <div>
              <p class="label">While you were away</p>
              <h2>At a glance</h2>
            </div>
          </div>
          <ul class="glance-list">
            <li class="glance-item">
              <span class="glance-item__art"><DeskArt name="learning" /></span>
              <div class="glance-item__body">
                <span class="glance-item__label">Learning</span>
                <p data-glance-learning>Not learning anything right now.</p>
              </div>
            </li>
            <li class="glance-item">
              <span class="glance-item__art"><DeskArt name="mailbox" /></span>
              <div class="glance-item__body">
                <span class="glance-item__label">Letters</span>
                <p data-glance-letters>No letters yet.</p>
              </div>
            </li>
            <li class="glance-item">
              <span class="glance-item__art"><DeskArt name="wardrobe" /></span>
              <div class="glance-item__body">
                <span class="glance-item__label">Looks</span>
                <p data-glance-looks>No looks saved yet.</p>
              </div>
            </li>
          </ul>
        </section>
      </div>

      <!-- ── Who you are, in one small line ────────────────────────────
           This used to be a card announcing "PAPER PASSPORT CONNECTED"
           with a 36-character id as the second-largest thing on the page.
           The name is worth a line; the id is a receipt, so it lives in
           the Account tab where receipts belong. ────────────────────── -->
      <section class="paper-card account-strip">
        <p>Signed in as <span class="account-strip__name" data-account-name>paper friend</span>.</p>
        <button class="btn btn--quiet" type="button" data-open-account>Account details</button>
      </section>

      <!-- ── Tabs ──────────────────────────────────────────────────────
           Five areas that used to be one page of stacked cards. The two
           you look at constantly are above; these are the ones you go
           looking for. ─────────────────────────────────────────────── -->
      <div class="desk-tabs" role="tablist" aria-label="Desk areas">
        <button class="desk-tab" type="button" role="tab" id="tab-scrapbook"
          aria-controls="panel-scrapbook" aria-selected="true" data-desk-tab="scrapbook">Scrapbook</button>
        <button class="desk-tab" type="button" role="tab" id="tab-letters" tabindex="-1"
          aria-controls="panel-letters" aria-selected="false" data-desk-tab="letters">Letters</button>
        <button class="desk-tab" type="button" role="tab" id="tab-looks" tabindex="-1"
          aria-controls="panel-looks" aria-selected="false" data-desk-tab="looks">Looks</button>
        <button class="desk-tab" type="button" role="tab" id="tab-profile" tabindex="-1"
          aria-controls="panel-profile" aria-selected="false" data-desk-tab="profile">Profile</button>
        <button class="desk-tab" type="button" role="tab" id="tab-account" tabindex="-1"
          aria-controls="panel-account" aria-selected="false" data-desk-tab="account">Account</button>
      </div>

      <div class="desk-panels">
        <section class="desk-panel" role="tabpanel" id="panel-scrapbook"
          aria-labelledby="tab-scrapbook" data-desk-panel="scrapbook" tabindex="0">
          <section class="paper-card panel-card">
            <div class="panel-head">
              <span class="panel-head__art"><DeskArt name="scrapbook" /></span>
              <div>
                <p class="label">Traveling with you</p>
                <h2>Scrapbook</h2>
                <p class="soft">
                  What you are carrying. It travels with your account from world to world.
                </p>
              </div>
            </div>
            <div data-inventory-summary><p class="soft">Opening your neighborhood pouch…</p></div>
            <div class="tech" data-tech hidden>
              <h3 class="tech__title">Learned techniques</h3>
              <div data-tech-summary><p class="soft">Opening your learned techniques…</p></div>
            </div>
          </section>
        </section>

        <section class="desk-panel" role="tabpanel" id="panel-letters"
          aria-labelledby="tab-letters" data-desk-panel="letters" tabindex="0" hidden>
          <section class="paper-card panel-card">
            <div class="panel-head">
              <span class="panel-head__art"><DeskArt name="mailbox" /></span>
              <div>
                <p class="label">Mailbox</p>
                <h2>Letters and parcels</h2>
                <p class="soft">
                  Letters and parcels wait here whether or not you were around when
                  they arrived. Collect one and it goes into your pouch.
                </p>
              </div>
            </div>
            <div data-mailbox-summary><p class="soft">Opening your mailbox…</p></div>
            <p class="mailbox__note" data-mailbox-note role="status" aria-live="polite"></p>
          </section>
        </section>

        <section class="desk-panel" role="tabpanel" id="panel-looks"
          aria-labelledby="tab-looks" data-desk-panel="looks" tabindex="0" hidden>
          <section class="paper-card panel-card">
            <div class="panel-head">
              <span class="panel-head__art"><DeskArt name="wardrobe" /></span>
              <div>
                <p class="label">Avatar</p>
                <h2>Your looks</h2>
                <p class="soft">
                  The drawings you wear. Make and change them without going into a
                  world — they save to your account as you go.
                </p>
              </div>
            </div>
            <div data-wardrobe-summary><p class="soft">Opening your wardrobe…</p></div>
            <p class="panel-card__actions">
              <button class="btn" type="button" data-open-studio>Open the avatar studio</button>
            </p>
            <p class="panel-card__note" data-open-studio-note role="status" aria-live="polite"></p>
          </section>
        </section>

        <section class="desk-panel" role="tabpanel" id="panel-profile"
          aria-labelledby="tab-profile" data-desk-panel="profile" tabindex="0" hidden>
          <section class="paper-card panel-card">
            <div class="panel-head">
              <div>
                <p class="label">How you are seen</p>
                <h2>Your profile</h2>
                <p class="soft">
                  A short introduction that travels with your account — what other
                  players may read about you when they look.
                </p>
              </div>
            </div>

            <p class="profile__status" data-profile-status role="status" aria-live="polite">
              Opening your profile…
            </p>

            <form class="profile" data-profile-form hidden>
              <div class="profile__block">
                <label class="profile__label" for="profile-bio">A little about you</label>
                <p class="soft" id="profile-bio-help">
                  Write a line or two. Other players may see this, depending on who you set it for below.
                </p>
                <textarea
                  class="field"
                  id="profile-bio"
                  name="profile-bio"
                  rows="3"
                  data-profile-bio
                  aria-describedby="profile-bio-help profile-bio-count"
                ></textarea>
                <p class="profile__count"><span id="profile-bio-count" data-profile-bio-count>0</span> / 280 characters</p>
              </div>

              <fieldset class="profile__audience" name="profile-visibility-bio">
                <legend>Who can see your bio</legend>
                <label class="choice">
                  <input type="radio" name="profile-visibility-bio" value="everyone" />
                  <span class="choice__text">
                    <span class="choice__name">Everyone</span>
                    <span class="choice__note">Anyone who finds you can see it, even someone you have never met.</span>
                  </span>
                </label>
                <label class="choice">
                  <input type="radio" name="profile-visibility-bio" value="friends" />
                  <span class="choice__text">
                    <span class="choice__name">Friends</span>
                    <span class="choice__note">Only people you have both agreed to be friends with can see it.</span>
                  </span>
                </label>
                <label class="choice">
                  <input type="radio" name="profile-visibility-bio" value="friends-of-friends" />
                  <span class="choice__text">
                    <span class="choice__name">Friends of friends</span>
                    <span class="choice__note">Your friends can see it, and so can their friends.</span>
                  </span>
                </label>
              </fieldset>

              <div class="profile__block">
                <h3 class="profile__subtitle">Links</h3>
                <p class="soft">
                  Up to six places a player can find you. Other players may see these,
                  depending on who you set them for below.
                </p>
                <div class="profile__links" data-profile-links></div>
                <button class="btn btn--quiet" type="button" data-profile-add-link>Add a link</button>
              </div>

              <fieldset class="profile__audience" name="profile-visibility-links">
                <legend>Who can see your links</legend>
                <label class="choice">
                  <input type="radio" name="profile-visibility-links" value="everyone" />
                  <span class="choice__text">
                    <span class="choice__name">Everyone</span>
                    <span class="choice__note">Anyone who finds you can see it, even someone you have never met.</span>
                  </span>
                </label>
                <label class="choice">
                  <input type="radio" name="profile-visibility-links" value="friends" />
                  <span class="choice__text">
                    <span class="choice__name">Friends</span>
                    <span class="choice__note">Only people you have both agreed to be friends with can see it.</span>
                  </span>
                </label>
                <label class="choice">
                  <input type="radio" name="profile-visibility-links" value="friends-of-friends" />
                  <span class="choice__text">
                    <span class="choice__name">Friends of friends</span>
                    <span class="choice__note">Your friends can see it, and so can their friends.</span>
                  </span>
                </label>
              </fieldset>

              <p class="profile__disclosure">
                <strong>One thing worth saying plainly:</strong> if you ask somebody to be
                friends, they can read your bio and your links — whatever you have set above.
                Asking to be friends should never be a blind request; the person you are asking
                gets to see who is asking. Nobody else sees more than your settings allow.
              </p>

              <p>
                <button class="btn" type="button" data-profile-save>Save profile</button>
              </p>
              <p class="profile__note" data-profile-note role="status" aria-live="polite"></p>
            </form>
          </section>
        </section>

        <section class="desk-panel" role="tabpanel" id="panel-account"
          aria-labelledby="tab-account" data-desk-panel="account" tabindex="0" hidden>
          <section class="paper-card panel-card">
            <div class="panel-head">
              <div>
                <p class="label">Your account</p>
                <h2>Account</h2>
                <p class="soft">
                  Your account is the part that stays the same everywhere you go. A
                  world remembers your house and your garden; your account remembers you.
                </p>
              </div>
            </div>

            <dl class="account-facts">
              <dt>Account</dt>
              <dd class="account-facts__id"><code data-account-id></code></dd>
            </dl>

            <!-- ── The one-time bridges ──────────────────────────────
                 These confused the owner, and fairly: the button stayed
                 visible long after the bridge had been walked. They are
                 only ever useful to somebody who played before accounts
                 existed, so they say that plainly and go away once used. -->
            <div class="bridge-intro">
              <h3 class="panel-card__subtitle">Bringing older progress in</h3>
              <p class="soft">
                If you played before papr.world had accounts, the things you gathered
                lived only in this browser. These two bridges copy that progress into
                your account once. Neither is needed if you started after accounts
                existed, and nothing is copied until you press the button.
              </p>
            </div>

            <div class="migration" data-migration hidden>
              <h4 class="migration__title">Solo save</h4>
              <p class="soft" data-migration-description>Checking this browser for a solo save…</p>
              <button class="btn btn--quiet" type="button" data-migration-button hidden>Copy my solo save in</button>
              <p class="migration__note" data-migration-note role="status" aria-live="polite"></p>
            </div>

            <div class="migration" data-wardrobe-import hidden>
              <h4 class="migration__title">Saved looks</h4>
              <p class="soft" data-wardrobe-import-description>Checking this browser for saved looks…</p>
              <button class="btn btn--quiet" type="button" data-wardrobe-import-button hidden>Copy my looks in</button>
              <p class="migration__note" data-wardrobe-import-note role="status" aria-live="polite"></p>
            </div>
          </section>
        </section>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/account';
  </script>

  <script>
    // Desk tabs.
    //
    // Five areas used to be one very long page of stacked cards, which is how
    // a 26-row inventory list ended up above the mailbox. Tabs are plain
    // buttons and panels rather than a framework: the whole behaviour is
    // "one panel is not hidden", so an accordion of libraries would be more
    // moving parts than behaviour.
    //
    // Nothing here touches the account logic. Every panel is in the DOM from
    // the start — hidden, not absent — because account.ts looks its hooks up
    // once on load and must find them wherever they now live.
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-desk-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-desk-panel]'));

    function showPane(id: string, options: { focus?: boolean; remember?: boolean } = {}) {
      if (!panels.some((panel) => panel.dataset.deskPanel === id)) return;
      for (const tab of tabs) {
        const selected = tab.dataset.deskTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && options.focus) tab.focus();
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.deskPanel !== id;
      }
      // Kept in the URL so "Update my profile" can point at the tab, a reload
      // lands where you were, and the browser's back button does the obvious
      // thing. `replaceState` because a tab is not a page.
      if (options.remember !== false) {
        const next = `${window.location.pathname}${window.location.search}#${id}`;
        window.history.replaceState(null, '', next);
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => showPane(tab.dataset.deskTab ?? '', { focus: true }));
    }

    // Arrow keys move between tabs, as the tab pattern expects.
    document.querySelector('.desk-tabs')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const step = key === 'ArrowRight' ? 1 : key === 'ArrowLeft' ? -1 : 0;
      if (step === 0 && key !== 'Home' && key !== 'End') return;
      event.preventDefault();
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const next = key === 'Home' ? 0
        : key === 'End' ? tabs.length - 1
          : (current + step + tabs.length) % tabs.length;
      showPane(tabs[next].dataset.deskTab ?? '', { focus: true });
    });

    // The two shortcut buttons. They are the same jump the tabs make, said in
    // the place the reader is standing: the card preview sends you to the
    // profile you would edit, the account strip to the account facts.
    document.querySelector('[data-open-profile]')?.addEventListener('click', () => {
      showPane('profile');
      panels.find((panel) => panel.dataset.deskPanel === 'profile')?.scrollIntoView({ block: 'start' });
    });
    document.querySelector('[data-open-account]')?.addEventListener('click', () => {
      showPane('account');
      panels.find((panel) => panel.dataset.deskPanel === 'account')?.scrollIntoView({ block: 'start' });
    });

    const requested = window.location.hash.replace('#', '');
    if (requested) showPane(requested, { remember: false });
    window.addEventListener('hashchange', () => {
      const id = window.location.hash.replace('#', '');
      if (id) showPane(id, { remember: false });
    });
  </script>
</Base>

<style lang="scss">
  .desk { max-width: 1080px; margin: 0 auto; padding: 130px var(--gutter) 110px; }
  .desk__head { display: flex; gap: 24px; align-items: start; justify-content: space-between; }
  .desk__title { @include hand(56px, 92px, 9vw); margin: 4px 0 14px; }
  .desk__lede { max-width: 620px; color: var(--ink-soft); font-size: 19px; }
  .desk__alpha { margin: 10px 0 0; max-width: 60ch; color: var(--ink-soft); }
  .desk__notice { margin: 28px 0; padding: 14px 18px; border-left: 4px solid var(--crayon); background: var(--paper-2); }
  .desk__notice[data-kind="error"] { border-color: #a33; }
  .desk__signin { max-width: 430px; margin: 38px auto; }
  .paper-card { @include card(var(--paper), var(--paper-2)); padding: clamp(22px, 3vw, 30px); }
  .paper-card h2 { margin: 7px 0 10px; font-size: 25px; }
  .claim { max-width: 700px; margin: 34px auto; }
  .claim .btn { display: inline-block; margin: 12px 8px 0 0; }
  .soft, :global(.coming) { color: var(--ink-soft); }
  :global(.coming) { display: inline-block; margin-top: 12px; font: 700 11px/1.35 $font-mono; text-transform: uppercase; letter-spacing: .06em; }

  // ── Vertical rhythm ──────────────────────────────────────────────────────
  // One stack, one gap. Previously each card carried its own margins, which
  // is how the page ended up with three different distances between things.
  [data-account-claimed] > * + * { margin-top: 22px; }

  // ── A section head: artwork, label, heading, one line ────────────────────
  .panel-head { display: flex; gap: 16px; align-items: flex-start; }
  .panel-head p { margin: 6px 0 0; max-width: 62ch; }
  .panel-head__art { flex: none; display: none; }
  @media (min-width: $bp-mid) { .panel-head__art { display: block; width: 76px; } }
  .panel-head__art :global(svg) { width: 100%; height: auto; display: block; }

  // ── Doors ────────────────────────────────────────────────────────────────
  .doors { margin-top: 0; }
  .world-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 20px; }
  :global(.world-card) { padding: 18px; border: 1px solid var(--edge); border-radius: 9px; background: var(--paper-2); }
  :global(.world-card h3) { margin: 7px 0 9px; font-size: 21px; }
  :global(.world-card p) { margin: 7px 0; }
  :global(.world-card__enter) { margin-top: 12px; }

  // ── The glance row ───────────────────────────────────────────────────────
  // Deliberately uneven: 1.15fr / 0.85fr. Equal columns were the original
  // problem — three boxes stretched to the tallest neighbour's height, so
  // two of them were mostly empty air.
  //
  // `align-items: start` is the other half of that fix, and it is the more
  // important half: a CSS grid stretches its items to the row height by
  // default, so without this the shorter card grows an empty tail anyway and
  // the unequal widths buy nothing. Each card is as tall as its own content.
  .desk-glance { display: grid; gap: 22px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: $bp-mid) { .desk-glance { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); } }

  // ── Card preview ─────────────────────────────────────────────────────────
  // The sheet itself is built by account.ts, so the children are :global for
  // the same reason the scrapbook's are.
  .card-preview { display: flex; flex-direction: column; }
  .card-preview__actions { margin: auto 0 0; padding-top: 18px; }
  :global(.card-preview__sheet) {
    margin-top: 16px; padding: 18px; border: 1px dashed var(--edge);
    border-radius: $radius-md; background: var(--paper-2);
  }
  :global(.card-preview__name) { margin: 0; font: 700 20px/1.2 $font-body; }
  :global(.card-preview__bio) { margin: 8px 0 0; max-width: 46ch; }
  :global(.card-preview__empty) { margin: 8px 0 0; color: var(--ink-faint); }
  :global(.card-preview__links) { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; padding: 0; list-style: none; }
  :global(.card-preview__links li) { padding: 3px 10px; border: 1px solid var(--edge); border-radius: 999px; background: var(--paper); font-size: 13px; }
  :global(.card-preview__who) { margin: 14px 0 0; font-size: 14px; color: var(--ink-faint); }

  .glance-list { margin: 18px 0 0; padding: 0; list-style: none; }
  .glance-item { display: flex; gap: 14px; align-items: flex-start; padding: 12px 0; border-top: 1px dashed var(--edge); }
  .glance-item:first-child { border-top: 0; padding-top: 0; }
  .glance-item__art { flex: none; width: 46px; opacity: .9; }
  .glance-item__art :global(svg) { width: 100%; height: auto; display: block; }
  .glance-item__body { min-width: 0; }
  .glance-item__label { display: block; font: 700 11px/1.35 $font-mono; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-faint); }
  .glance-item__body p { margin: 5px 0 0; }

  // ── The account strip ────────────────────────────────────────────────────
  .account-strip { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; }
  .account-strip p { margin: 0; }
  .account-strip__name { font-weight: 700; }

  // ── Tabs ─────────────────────────────────────────────────────────────────
  .desk-tabs {
    display: flex; flex-wrap: wrap; gap: 6px 8px; margin-top: 30px;
    border-bottom: 1px solid var(--edge-soft); padding-bottom: 2px;
  }
  .desk-tab {
    @include label;                 // the small typewritten capitals the site already uses
    appearance: none; background: transparent; border: 0;
    border-radius: $radius-sm $radius-sm 0 0;
    padding: 11px 14px; cursor: pointer; color: var(--ink-soft);
