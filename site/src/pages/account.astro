---
import Base from '../layouts/Base.astro';

const clerkPublishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
const apiUrl = import.meta.env.PUBLIC_PAPR_API_URL
  ?? 'https://paprworld-production.up.railway.app';
---

<Base
  title="Your desk"
  description="Your papr.world account, worlds, and traveling scrapbook."
  sky={false}
  noindex
>
  <section
    class="desk"
    data-account-shell
    data-clerk-publishable-key={clerkPublishableKey}
    data-api-url={apiUrl}
  >
    <header class="desk__head">
      <div>
        <p class="label">Your place between worlds</p>
        <h1 class="hand desk__title">Your desk</h1>
        <p class="desk__lede">The things that belong to you, even when you leave a neighborhood.</p>
        <p class="desk__alpha">
          <strong>Early alpha.</strong> Expect rough edges — and now and then a
          world or progress reset. Send feedback from the game’s Help menu.
        </p>
      </div>
      <div data-account-user-button></div>
    </header>

    <p class="desk__notice" data-account-message role="status" aria-live="polite">
      Opening your desk…
    </p>

    <div class="desk__signin" data-account-signin hidden>
      <div data-account-signin-target></div>
    </div>

    <section class="paper-card claim" data-account-claim hidden>
      <p class="label">One-time bridge</p>
      <h2>Bring your paper passport home</h2>
      <p data-claim-description>Checking this browser for a paper passport…</p>
      <p class="soft">
        Existing players keep their mail, pouch, and maker credits. New players get
        a fresh passport, a private solo world, and Shared World access automatically.
      </p>
      <button class="btn" type="button" data-claim-button disabled>Claim this passport</button>
      <a class="btn btn--quiet" href="/enter/">Enter a neighborhood</a>
    </section>

    <div data-account-claimed hidden>
      <section class="paper-card identity-card">
        <p class="label">Paper passport connected</p>
        <h2>Welcome back, <span data-account-name>paper friend</span>.</h2>
        <p class="identity-card__id">Account <code data-account-id></code></p>
      </section>

      <div class="desk-grid" aria-label="Account areas">
        <section class="paper-card worlds-card">
          <p class="label">Worlds</p>
          <h2>Your doors</h2>
          <p>These permissions belong to your account rather than an expiring neighborhood link.</p>
          <div class="world-list" data-world-list></div>
        </section>
        <section class="paper-card">
          <p class="label">Traveling with you</p>
          <h2>Scrapbook</h2>
          <div data-inventory-summary><p class="soft">Opening your neighborhood pouch…</p></div>
          <div class="tech" data-tech hidden>
            <h3 class="tech__title">Learned techniques</h3>
            <div data-tech-summary><p class="soft">Opening your learned techniques…</p></div>
          </div>
          <div class="migration" data-migration hidden>
            <h3 class="migration__title">Bring your solo save home</h3>
            <p class="soft" data-migration-description>Checking this browser for a solo save…</p>
            <button class="btn btn--quiet" type="button" data-migration-button hidden>Bring it into your account</button>
            <p class="migration__note" data-migration-note role="status" aria-live="polite"></p>
          </div>
        </section>
        <section class="paper-card">
          <p class="label">Mailbox</p>
          <h2>Letters and parcels</h2>
          <div data-mailbox-summary><p class="soft">Opening your mailbox…</p></div>
          <p class="mailbox__note" data-mailbox-note role="status" aria-live="polite"></p>
        </section>
        <section class="paper-card">
          <p class="label">Avatar</p>
          <h2>Your looks</h2>
          <div data-wardrobe-summary><p class="soft">Opening your wardrobe…</p></div>
          <p>
            <button class="btn" type="button" data-open-studio>Open the avatar studio</button>
          </p>
          <p class="soft">Make and change looks without going into a world. They save to your account as you go.</p>
          <p class="migration__note" data-open-studio-note role="status" aria-live="polite"></p>
          <div class="migration wardrobe-import" data-wardrobe-import hidden>
            <h3 class="migration__title">Bring your wardrobe home</h3>
            <p class="soft" data-wardrobe-import-description>Checking this browser for saved looks…</p>
            <button class="btn btn--quiet" type="button" data-wardrobe-import-button hidden>Bring it into your account</button>
            <p class="migration__note" data-wardrobe-import-note role="status" aria-live="polite"></p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/account';
  </script>
</Base>

<style lang="scss">
  .desk { max-width: 1080px; margin: 0 auto; padding: 130px var(--gutter) 110px; }
  .desk__head { display: flex; gap: 24px; align-items: start; justify-content: space-between; }
  .desk__title { @include hand(56px, 92px, 9vw); margin: 4px 0 14px; }
  .desk__lede { max-width: 620px; color: var(--ink-soft); font-size: 19px; }
  .desk__alpha { margin: 10px 0 0; max-width: 60ch; color: var(--ink-soft); }
  .desk__notice { margin: 28px 0; padding: 14px 18px; border-left: 4px solid var(--crayon); background: var(--paper-2); }
  .desk__notice[data-kind="error"] { border-color: #a33; }
  .desk__signin { max-width: 430px; margin: 38px auto; }
  .paper-card { @include card(var(--paper), var(--paper-2)); padding: clamp(22px, 3vw, 30px); }
  .paper-card h2 { margin: 7px 0 10px; font-size: 25px; }
  .claim { max-width: 700px; margin: 34px auto; }
  .claim .btn { display: inline-block; margin: 12px 8px 0 0; }
  .identity-card { margin: 32px 0 22px; }
  .identity-card__id { color: var(--ink-soft); }
  .identity-card code { overflow-wrap: anywhere; }
  .desk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 18px; }
  .worlds-card { grid-column: 1 / -1; }
  .world-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 20px; }
  :global(.world-card) { padding: 18px; border: 1px solid var(--edge); border-radius: 9px; background: var(--paper-2); }
  :global(.world-card h3) { margin: 7px 0 9px; font-size: 21px; }
  :global(.world-card p) { margin: 7px 0; }
  :global(.world-card__enter) { margin-top: 12px; }
  :global(.desk-list) { margin: 14px 0 0; padding: 0; list-style: none; }
  :global(.desk-list li) { padding: 10px 0; border-top: 1px dashed var(--edge); }
  :global(.desk-list strong) { display: block; }
  :global(.desk-list span), :global(.desk-list small) { display: block; margin-top: 3px; }
  :global(.desk-list small) { color: var(--ink-soft); }
  .soft, :global(.coming) { color: var(--ink-soft); }
  :global(.coming) { display: inline-block; margin-top: 12px; font: 700 11px/1.35 $font-mono; text-transform: uppercase; letter-spacing: .06em; }
  .migration { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--edge); }
  .migration__title { margin: 0 0 6px; font-size: 16px; }
  .migration__note { margin-top: 8px; }
  .migration [data-migration-button] { margin-top: 4px; }
  .tech { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--edge); }
  .tech__title { margin: 0 0 6px; font-size: 16px; }
  .tech :global(.tech-list) { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; padding: 0; list-style: none; }
  .tech :global(.tech-list li) { padding: 3px 10px; border: 1px solid var(--edge); border-radius: 999px; background: var(--paper-2); font-size: 13px; }
  .mailbox__heading { margin: 14px 0 0; font-size: 16px; }
  .mailbox__heading + :global(.desk-list) { margin-top: 8px; }
  .mailbox__note { margin: 8px 0 0; }
  .mailbox__note:empty { display: none; }
  :global(.desk-list .btn) { display: inline-block; margin-top: 10px; }
</style>
