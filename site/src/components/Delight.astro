---
/**
 * The page furniture for the playful bits: the tool that trails your pointer,
 * the little friend who walks down the page, the panel where you draw over
 * him, and the note the cheat code reveals.
 *
 * All of it is decoration. Every piece is either aria-hidden or a real,
 * labelled, keyboard-reachable control — nothing here is a div pretending to
 * be a button. Turn the whole lot off for a page with <Base delight={false}>.
 */
---

{/* The held tool. Purely decorative and never in the way of a click. */}
<div class="tool" data-tool aria-hidden="true">
  <img data-tool-img src="/assets/scenery/cursor-hand.svg" alt="" />
</div>

{/* The friend. */}
<div class="pal" data-pal>
  <button type="button" class="pal__button" data-studio-open>
    <span class="pal__label">Draw over the little paper friend</span>

    <span class="pal__bob">
      <span class="pal__lean">
        <svg class="pal__drawing" width="96" height="120" viewBox="0 0 512 512" aria-hidden="true">
          <path d="M169 98 C204 55 268 58 302 104 C332 146 315 228 286 278 C318 315 306 405 250 422 C191 440 137 399 151 329 C107 284 122 155 169 98 Z"
            fill="var(--potato)" stroke="var(--potato-line)" stroke-width="10" />
          <path d="M188 155 Q214 135 238 157" fill="none" stroke="var(--potato-ink)" stroke-width="8" stroke-linecap="round" />
          <g class="pal__eye"><circle cx="202" cy="204" r="11" fill="var(--potato-ink)" /></g>
          <g class="pal__eye pal__eye--right"><circle cx="263" cy="204" r="11" fill="var(--potato-ink)" /></g>
          <path d="M202 258 Q237 291 276 256" fill="none" stroke="var(--potato-ink)" stroke-width="8" stroke-linecap="round" />
          <path class="pal__arm"  d="M152 288 L83 319"  stroke="var(--potato-line)" stroke-width="14" stroke-linecap="round" />
          <path class="pal__arm pal__arm--right" d="M290 284 L359 309" stroke="var(--potato-line)" stroke-width="14" stroke-linecap="round" />
          <path class="pal__leg"  d="M189 417 L174 487" stroke="var(--potato-line)" stroke-width="14" stroke-linecap="round" />
          <path class="pal__leg pal__leg--right" d="M258 417 L281 487" stroke="var(--potato-line)" stroke-width="14" stroke-linecap="round" />
          <path d="M176 114 L282 400" stroke="#fff7df" stroke-width="5" opacity=".3" />
        </svg>

        {/* Whatever you draw replaces him, fading the original out. */}
        <img class="pal__worn" data-pal-img alt="" aria-hidden="true" />
      </span>
    </span>

    <span class="pal__say" data-pal-say aria-hidden="true">hi</span>
  </button>
</div>

{/* The drawing panel. A real <dialog>, so Escape, focus and inertness are free. */}
<dialog class="studio" data-studio aria-labelledby="studio-title">
  <div class="studio__sheet">
    <h2 class="studio__title" id="studio-title">Draw your friend</h2>
    <p class="studio__blurb">
      Whatever you make here follows you down the page. This is roughly how the
      real avatar editor starts.
    </p>

    <canvas data-canvas width="300" height="375" class="studio__canvas"
      aria-label="A sheet of paper to draw your friend on"></canvas>

    <div class="studio__crayons" role="group" aria-label="Crayon colour">
      {[
        ['#2f251d', 'graphite'], ['#b8402f', 'red'], ['#2f6fa8', 'blue'],
        ['#3f8f45', 'green'], ['#c98a1b', 'yellow'], ['#8a5aa8', 'purple'],
      ].map(([hex, name], index) => (
        <button
          type="button" class="crayon" data-crayon={hex}
          style={`--crayon-colour:${hex}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="pal__label">{name} crayon</span>
        </button>
      ))}

      <span class="studio__spacer"></span>
      <button type="button" class="studio__minor" data-studio-clear>Start over</button>
    </div>

    <div class="studio__actions">
      <button type="button" class="btn studio__wear" data-studio-wear>Wear it</button>
      <button type="button" class="studio__minor" data-studio-close>Never mind</button>
    </div>
  </div>
</dialog>

{/* Revealed by the cheat code. Hidden properly, so it is not read out early. */}
<aside class="secret" data-secret hidden aria-label="A secret you found">
  <div class="secret__pad">
    <p class="secret__flag">You found it</p>
    <p class="secret__body">The old development neighbourhood is still standing. Its code is</p>
    <p class="secret__code">PAPR-22</p>
    <p class="secret__foot">whether it lets you in is another matter.</p>
  </div>
</aside>

<style lang="scss">
  // ── The held tool ────────────────────────────────────────────────────────

  .tool {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 55;
    width: 64px;
    height: 64px;
    margin: -6px 0 0 6px;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--tool-x, 0px), var(--tool-y, 0px), 0) rotate(var(--tool-r, -14deg));
    transition: opacity $dur-settle;

    img { display: block; width: 100%; height: 100%; filter: drop-shadow(3px 4px 4px var(--sh-2)); }
  }

  // No pointer to trail, so no tool.
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .tool { display: none; }
  }

  // ── The friend ───────────────────────────────────────────────────────────

  .pal {
    position: fixed;
    left: 26px;
    top: 0;
    z-index: 50;
    width: 96px;
    transform: translate3d(0, var(--pal-y, 60vh), 0);
  }

  // He needs room in the margin that a narrow window does not have.
  @media (max-width: $bp-wide) { .pal { display: none; } }

  .pal__button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .pal__label { @include sr-only; }

  .pal__bob  { display: block; animation: bob 3.4s ease-in-out infinite; }
  .pal__lean { display: block; transform: rotate(var(--pal-lean, 0deg)); transition: transform .5s ease-out; }

  .pal__drawing {
    display: block;
    // Fades out as --pal-drawn goes to 1, revealing whatever you drew.
    opacity: calc(1 - var(--pal-drawn, 0));
    filter: drop-shadow(5px 8px 0 var(--sh-1));
  }

  .pal__worn {
    position: absolute;
    inset: 0;
    width: 96px;
    height: 120px;
    object-fit: contain;
    opacity: var(--pal-drawn, 0);
    filter: drop-shadow(5px 8px 0 var(--sh-1));
    pointer-events: none;
  }

  .pal__eye { animation: blink 6.5s ease-in-out infinite; transform-origin: 202px 204px; }
  .pal__eye--right { transform-origin: 263px 204px; }

  .pal__arm { transform-origin: 152px 288px; animation: waddle 1.1s ease-in-out infinite; }
  .pal__arm--right { transform-origin: 290px 284px; animation-direction: reverse; }

  .pal__leg { transform-origin: 189px 417px; animation: waddle .55s ease-in-out infinite; }
  .pal__leg--right { transform-origin: 258px 417px; animation-direction: reverse; }

  @keyframes bob    { 0%, 100% { transform: translateY(0) } 50% { transform: translateY(-9px) } }
  @keyframes blink  { 0%, 92%, 100% { transform: scaleY(1) } 96% { transform: scaleY(.06) } }
  @keyframes waddle { 0%, 100% { transform: rotate(-4deg) } 50% { transform: rotate(4deg) } }

  .pal__say {
    position: absolute;
    left: 96%;
    top: 6px;
    padding: 6px 11px 7px;
    background: var(--paper);
    border: 1px solid var(--edge);
    // Square corner bottom-left, pointing back at whoever is speaking.
    border-radius: 11px 11px 11px 2px;
    box-shadow: 2px 5px 12px var(--sh-1);
    font: 400 13px/1.2 $font-note;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    transition: opacity $dur-settle;
  }

  // ── The drawing panel ────────────────────────────────────────────────────

  .studio {
    max-width: min(420px, 94vw);
    padding: 0;
    background: none;
    border: 0;

    &::backdrop { background: rgb(30 22 14 / .55); backdrop-filter: blur(3px); }
  }

  .studio__sheet {
    @include card(var(--paper), var(--paper-2));
    --tilt: -.8deg;
    padding: 26px 24px 24px;
    border-radius: 8px 20px 8px 18px;
    box-shadow: 0 30px 70px rgb(0 0 0 / .4);

    &::before { @include tape(22%, 90px, -4deg, -15px); }
  }

  .studio__title { @include hand(40px, 54px, 6vw); margin: 0 0 4px; }

  .studio__blurb { margin: 0 0 16px; font: 400 14px/1.5 $font-body; color: var(--ink-soft); }

  .studio__canvas {
    display: block;
    width: 100%;
    aspect-ratio: 300 / 375;
    @include ruled(25px);
    background-color: var(--paper-2);
    border: 1px solid var(--edge);
    border-radius: 8px;
    touch-action: none;
    cursor: crosshair;
  }

  .studio__crayons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 14px;
  }

  .crayon {
    position: relative;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 2px solid var(--edge);
    border-radius: 50%;
    background: var(--crayon-colour);
    cursor: pointer;

    // Chosen: a heavier ring AND a dot in the middle, so it is not colour
    // alone marking the selection.
    &[aria-pressed="true"] {
      border-color: var(--ink);
      box-shadow: inset 0 0 0 3px var(--paper);
    }
  }

  .studio__spacer { flex: 1; }

  .studio__minor {
    padding: 9px 13px;
    background: var(--paper-2);
    border: 1px solid var(--edge);
    border-radius: 9px;
    font: 500 14px/1 $font-body;
    color: var(--ink-soft);
    cursor: pointer;

    &:hover { background: var(--kraft-2); color: var(--ink); }
  }

  .studio__actions { display: flex; gap: 10px; margin-top: 18px; }
  .studio__wear    { flex: 1; }

  // ── The secret ───────────────────────────────────────────────────────────

  .secret {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 80;
    width: 190px;
    animation: pop $dur-settle ease-out;
  }

  @keyframes pop {
    from { transform: scale(.4) rotate(-14deg); opacity: 0 }
    to   { transform: scale(1) rotate(0); opacity: 1 }
  }

  .secret__pad {
    position: relative;
    padding: 18px 16px 20px;
    background: #f3c9a1;
    border-radius: 3px 3px 10px 3px;
    box-shadow: 4px 12px 26px rgb(0 0 0 / .35);
    transform: rotate(-4deg);

    &::before {
      @include tape(44%, 60px, 6deg, -12px);
      background: rgb(255 255 255 / .5);
      border-color: rgb(72 54 36 / .25);
    }
  }

  .secret__flag  { margin: 0; font: 700 11px/1 $font-mono; letter-spacing: .14em; text-transform: uppercase; color: #6d4523; }
  .secret__body  { margin: 8px 0 0; font: 400 13px/1.45 $font-mono; color: #4a2f16; }
  .secret__code  { margin: 8px 0 0; font: 700 26px/1 $font-mono; color: #3a2410; }
  .secret__foot  { margin: 10px 0 0; font: 400 11px/1.4 $font-mono; color: #7a5533; }
</style>
