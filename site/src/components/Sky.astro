---
/**
 * The sky: a gradient, a warm lamp glow, and four paper clouds drifting past.
 *
 * Fixed to the viewport and behind everything, so it stays put while the page
 * scrolls over it — the same trick the game uses.
 *
 * The two gradient stops are custom properties (--sky-h at the horizon,
 * --sky-z at the zenith) because src/scripts/sky.ts walks them through four
 * paper moods on a twelve-minute lap, mirroring the game's own sky.ts.
 */
---

<div class="sky" aria-hidden="true">
  <div class="sky__wash"></div>
  <div class="sky__lamp"></div>

  <div class="sky__clouds">
    {[
      { top: '7vh',  drift: '148s', delay: '0s',    bob: '17s', w: 300, o: 1 },
      { top: '20vh', drift: '210s', delay: '-70s',  bob: '23s', w: 200, o: .9 },
      { top: '3vh',  drift: '320s', delay: '-180s', bob: '31s', w: 440, o: .75 },
      { top: '34vh', drift: '260s', delay: '-30s',  bob: '29s', w: 170, o: .55 },
    ].map((cloud) => (
      <div
        class="sky__lane"
        style={`top:${cloud.top};animation-duration:${cloud.drift};animation-delay:${cloud.delay};opacity:${cloud.o};`}
      >
        <svg
          class="sky__cloud"
          width={cloud.w}
          height={cloud.w * 0.4}
          viewBox="0 0 300 120"
          style={`animation-duration:${cloud.bob}`}
        >
          {/* Drawn twice: the lower copy is the shaded underside of the cutout. */}
          <g fill="var(--cloud-shade)">
            <circle cx="64" cy="76" r="30" /><circle cx="112" cy="62" r="42" />
            <circle cx="168" cy="70" r="34" /><circle cx="212" cy="80" r="24" />
          </g>
          <g fill="var(--cloud)">
            <circle cx="60" cy="72" r="30" /><circle cx="108" cy="58" r="42" />
            <circle cx="164" cy="66" r="34" /><circle cx="208" cy="76" r="24" />
          </g>
        </svg>
      </div>
    ))}
  </div>
</div>

<style lang="scss">
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sky__wash {
    position: absolute;
    inset: 0;
    // The bottom 12% is flat horizon colour so the hills sit on a band rather
    // than on a gradient that keeps changing under them.
    background: linear-gradient(to top, var(--sky-h) 0%, var(--sky-h) 12%, var(--sky-z) 100%);
    transition: background .8s linear;
  }

  .sky__lamp {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 60% at 82% 6%, var(--lamp), transparent 65%);
  }

  .sky__clouds {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .sky__lane {
    position: absolute;
    left: 0;
    animation-name: drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .sky__cloud {
    display: block;
    animation: bob ease-in-out infinite;
  }

  @keyframes drift {
    from { transform: translateX(-30vw); }
    to   { transform: translateX(130vw); }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-9px); }
  }

  // A sky that never moves is still a sky.
  @media (prefers-reduced-motion: reduce) {
    .sky__lane { animation: none; }
    .sky__lane:nth-child(1) { transform: translateX(12vw); }
    .sky__lane:nth-child(2) { transform: translateX(58vw); }
    .sky__lane:nth-child(3) { transform: translateX(31vw); }
    .sky__lane:nth-child(4) { transform: translateX(76vw); }
  }
</style>
