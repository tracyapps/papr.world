---
/**
 * One hidden critter you can befriend by clicking it.
 *
 * TO HIDE A NEW ONE: add it to src/data/critters.ts, then drop
 * <Critter id="your-id" /> anywhere on a page. The footer tally counts the
 * data file, so it updates itself.
 *
 * It is a real <button> with a real accessible name, so it can be found and
 * befriended with a keyboard, and a screen reader is told what happened.
 */
import { CRITTERS } from '../data/critters';

interface Props {
  id: string;
  /** Which drawing to use. */
  shape?: 'snail' | 'moth' | 'mouse' | 'spider' | 'beetle';
  /** CSS the critter is positioned with, e.g. "left: 8vw; bottom: 17vh;" */
  place?: string;
  size?: number;
}

const { id, shape = 'snail', place = '', size = 52 } = Astro.props;
const critter = CRITTERS.find((c) => c.id === id);
if (!critter) throw new Error(`Critter "${id}" is not in src/data/critters.ts`);
---

<button
  type="button"
  class="critter"
  data-critter={id}
  data-found-label={critter.found}
  style={place}
  aria-pressed="false"
>
  <span class="critter__name">{critter.hint}</span>

  {shape === 'snail' && (
    <svg width={size} height={size * 1.23} viewBox="0 0 89 110" aria-hidden="true">
      <path d="M 17 29 C 17 29 13 7 13 7 C 13 7 21 9 21 9 C 21 9 25 29 25 29 C 25 29 33 29 33 29 C 33 29 37 9 37 9 C 37 9 45 7 45 7 C 45 7 41 31 41 31 C 49 35 53 43 51 51 C 69 45 87 57 87 77 C 87 97 69 109 51 105 C 51 105 7 105 7 105 C -3 97 -1 81 9 77 C 3 61 7 39 17 29 Z"
        fill="var(--potato)" stroke="var(--potato-line)" stroke-width="4" stroke-linejoin="round" />
    </svg>
  )}

  {shape === 'moth' && (
    <svg width={size} height={size} viewBox="0 0 100 140" aria-hidden="true">
      <path d="M50 18 C74 18 88 46 86 82 C84 116 70 128 50 128 C30 128 16 116 14 82 C12 46 26 18 50 18 Z"
        fill="var(--potato)" stroke="var(--potato-line)" stroke-width="5" />
      <path d="M50 30 L50 118" stroke="var(--potato-line)" stroke-width="4" />
      <path d="M44 22 L34 6 M56 22 L66 6" stroke="var(--potato-line)" stroke-width="4" stroke-linecap="round" />
    </svg>
  )}

  {shape === 'mouse' && (
    <svg width={size} height={size * 0.72} viewBox="0 0 120 86" aria-hidden="true">
      <path d="M22 74 C4 74 2 46 24 38 C40 32 52 12 76 12 C100 12 114 30 114 50 C114 66 102 74 86 74 Z"
        fill="var(--potato)" stroke="var(--potato-line)" stroke-width="5" stroke-linejoin="round" />
      <circle cx="86" cy="30" r="13" fill="none" stroke="var(--potato-line)" stroke-width="5" />
      <circle cx="98" cy="48" r="4" fill="var(--potato-ink)" />
      <path d="M22 74 C6 78 2 66 10 60" fill="none" stroke="var(--potato-line)" stroke-width="5" stroke-linecap="round" />
    </svg>
  )}

  {shape === 'spider' && (
    <svg width={size} height={size * 1.1} viewBox="0 0 100 110" aria-hidden="true">
      <path d="M50 2 L50 40" stroke="var(--potato-line)" stroke-width="3" />
      <ellipse cx="50" cy="66" rx="26" ry="28" fill="var(--potato)" stroke="var(--potato-line)" stroke-width="5" />
      <g stroke="var(--potato-line)" stroke-width="4" stroke-linecap="round" fill="none">
        <path d="M26 54 L6 40 M26 66 L4 66 M26 78 L8 94" />
        <path d="M74 54 L94 40 M74 66 L96 66 M74 78 L92 94" />
      </g>
      <circle cx="42" cy="58" r="4" fill="var(--potato-ink)" />
      <circle cx="58" cy="58" r="4" fill="var(--potato-ink)" />
    </svg>
  )}

  {shape === 'beetle' && (
    <svg width={size} height={size * 0.86} viewBox="0 0 110 94" aria-hidden="true">
      <g stroke="var(--potato-line)" stroke-width="4" stroke-linecap="round">
        <path d="M28 26 L8 12 M22 47 L2 47 M28 68 L8 84" />
        <path d="M82 26 L102 12 M88 47 L108 47 M82 68 L102 84" />
      </g>
      <ellipse cx="55" cy="52" rx="30" ry="36" fill="var(--potato)" stroke="var(--potato-line)" stroke-width="5" />
      <path d="M55 20 L55 86" stroke="var(--potato-line)" stroke-width="4" />
      <circle cx="55" cy="16" r="12" fill="var(--potato)" stroke="var(--potato-line)" stroke-width="5" />
    </svg>
  )}
</button>

<style lang="scss">
  .critter {
    position: absolute;
    z-index: 11;
    padding: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: .55;
    filter: drop-shadow(3px 5px 0 var(--sh-1));
    transition: opacity $dur-settle $ease-paper, transform $dur-settle $ease-paper;

    &:hover,
    &:focus-visible { opacity: 1; }

    @media (prefers-reduced-motion: no-preference) {
      &:hover,
      &:focus-visible { transform: translateY(-5px) scale(1.12); }
    }

    // Befriended. Stays lifted and bright so you can see which ones you have.
    &[aria-pressed="true"] {
      opacity: 1;
      transform: translateY(-6px) scale(1.1);
    }
  }

  // The name is for assistive tech and for anyone tabbing through. It is not
  // display: none, because a hidden element is not announced or focusable.
  .critter__name { @include sr-only; }

  svg { display: block; }
</style>
