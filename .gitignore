node_modules/
dist/
output/
.DS_Store
# Anchored with a leading slash on purpose. Without it this pattern matches a
# folder called "designs" at ANY depth, which silently swallowed the site's
# own site/public/assets/designs before it was ever committed.
/designs/
.backup/
.qa/
.playwright-cli/

# Generated by tools/build-reference.mjs on every build and every deploy.
# Never committed: a checked-in copy is one more thing that can go stale.
docs-site/

# The assembled deploy tree from tools/build-web.mjs. Rebuilt on every push;
# a checked-in copy is one more thing that can go stale.
web/
site/src/data/roadmap.json

# Staged from docs-site/ by tools/stage-reference.mjs on every dev start
# and every build. Generated, like docs-site itself.
site/public/reference/
